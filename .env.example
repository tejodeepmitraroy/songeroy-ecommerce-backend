# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# ==============================================================================
# Database Configuration (PostgreSQL >= 15 with Prisma ORM)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom"

# ==============================================================================
# General JWT Configuration (Fallback defaults, min 32 chars)
# ==============================================================================
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_me_in_prod_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_me_in_prod_12345
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# Admin API JWT Configuration (Audience: admin-api, min 32 chars)
# ==============================================================================
ADMIN_JWT_ACCESS_SECRET=admin_super_secret_jwt_access_token_key_change_me_12345
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_SECRET=admin_super_secret_jwt_refresh_token_key_change_me_12345
ADMIN_JWT_REFRESH_EXPIRES_IN=7d
ADMIN_JWT_ISSUER=songeroy-backend
ADMIN_JWT_AUDIENCE=admin-api

# ==============================================================================
# Storefront API JWT Configuration (Audience: store-api, min 32 chars)
# ==============================================================================
STORE_JWT_ACCESS_SECRET=store_super_secret_jwt_access_token_key_change_me_12345
STORE_JWT_ACCESS_EXPIRES_IN=15m
STORE_JWT_REFRESH_SECRET=store_super_secret_jwt_refresh_token_key_change_me_12345
STORE_JWT_REFRESH_EXPIRES_IN=7d
STORE_JWT_ISSUER=songeroy-backend
STORE_JWT_AUDIENCE=store-api

# ==============================================================================
# Redis Cache & Background Queue
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# Client URLs / CORS Whitelist
# ==============================================================================
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ==============================================================================
# Payment Gateways (Razorpay & Stripe)
# ==============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# File Storage (AWS S3)
# ==============================================================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==============================================================================
# Email Notification (SMTP / Nodemailer)
# ==============================================================================
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@songeroy.com
