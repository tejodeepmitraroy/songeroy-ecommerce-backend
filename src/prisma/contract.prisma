// use prisma-8

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------
enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  INVENTORY_MANAGER
  ORDER_MANAGER
  CUSTOMER_SUPPORT
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  CASH_ON_DELIVERY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InventoryMovementType {
  RESTOCK
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

// ----------------------------------------------------
// USER MANAGEMENT
// ----------------------------------------------------
model User {
  uid             String          @id @onCreate(uuid())
  email           String          @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  phoneNumber     String?         @unique
  isEmailVerified Boolean         @default(false)
  isActive        Boolean         @default(true)
  refreshTokens   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @onCreate(now()) @onUpdate(now())

  addresses       Address[]
  orders          Order[]
  cart            Cart?
  wishlist        Wishlist?
  reviews         Review[]
  returnRequests  ReturnRequest[]
  notifications   Notification[]
  couponUsages    CouponUsage[]

  @@index([email])
  @@index([phoneNumber])
}

model Address {
  id            String   @id @onCreate(uuid())
  userId        String
  recipientName String
  phoneNumber   String
  streetAddress String
  apartment     String?
  city          String
  state         String
  postalCode    String
  country       String   @default("IN")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @onCreate(now()) @onUpdate(now())

  user          User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------
// EMPLOYEE MANAGEMENT
// ----------------------------------------------------
model Employee {
  uid             String         @id @onCreate(uuid())
  email           String         @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  isEmailVerified Boolean        @default(false)
  isActive        Boolean        @default(true)
  refreshTokens   String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @onCreate(now()) @onUpdate(now())
  employeeRoles   EmployeeRole[]

  @@index([email])
}

model EmployeeRole {
  id         String   @id @onCreate(uuid())
  employeeId String
  roleId     Int
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [uid], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [rid], onDelete: Cascade)

  @@unique([employeeId, roleId])
  @@index([employeeId])
  @@index([roleId])
}

model Role {
  rid             Int              @id
  name            RoleName         @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @onCreate(now()) @onUpdate(now())

  employeeRoles   EmployeeRole[]
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @onCreate(uuid())
  roleId       Int
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [rid], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [rid], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Permission {
  rid             String           @id @onCreate(uuid())
  action          String // e.g. "products:create", "orders:read"
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @onCreate(now()) @onUpdate(now())
  rolePermissions RolePermission[]

  @@unique([action])
}

// ----------------------------------------------------
// PRODUCT CATALOG
// ----------------------------------------------------
model Category {
  id          String            @id @onCreate(uuid())
  name        String
  slug        String            @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @onCreate(now()) @onUpdate(now())

  parent      Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryHierarchy")
  products    ProductCategory[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id          String    @id @onCreate(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

  products    Product[]

  @@index([slug])
}

model Product {
  id          String               @id @onCreate(uuid())
  name        String
  slug        String               @unique
  description String?
  basePrice   NumericString(12, 2)
  currency    String               @default("INR")
  brandId     String?
  isActive    Boolean              @default(true)
  isFeatured  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @onCreate(now()) @onUpdate(now())

  brand       Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories  ProductCategory[]
  variants    ProductVariant[]
  images      ProductImage[]
  attributes  ProductAttribute[]
  reviews     Review[]

  @@index([slug])
  @@index([brandId])
  @@index([isActive, isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model ProductVariant {
  id              String                  @id @onCreate(uuid())
  productId       String
  sku             String                  @unique
  title           String
  price           NumericString(12, 2)
  compareAtPrice  NumericString(12, 2)?
  currency        String                  @default("INR")
  barcode         String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @onCreate(now()) @onUpdate(now())

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues ProductAttributeValue[]
  inventoryItems  Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservations    StockReservation[]
  returnItems     ReturnItem[]

  @@index([sku])
  @@index([productId])
}

model ProductImage {
  id        String   @id @onCreate(uuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id        String                  @id @onCreate(uuid())
  productId String
  name      String // e.g. "Color", "Size"
  createdAt DateTime                @default(now())

  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@index([productId])
}

model ProductAttributeValue {
  id          String           @id @onCreate(uuid())
  attributeId String
  variantId   String
  value       String // e.g. "Red", "XL"

  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([attributeId])
  @@index([variantId])
}

// ----------------------------------------------------
// INVENTORY
// ----------------------------------------------------
model Warehouse {
  id          String      @id @onCreate(uuid())
  name        String
  code        String      @unique
  address     String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @onCreate(now()) @onUpdate(now())

  inventories Inventory[]
}

model Inventory {
  id            String              @id @onCreate(uuid())
  variantId     String
  warehouseId   String
  physicalStock Int                 @default(0)
  reservedStock Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @onCreate(now()) @onUpdate(now())

  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
}

model InventoryMovement {
  id          String                @id @onCreate(uuid())
  inventoryId String
  quantity    Int
  type        InventoryMovementType
  referenceId String? // e.g. Order ID, Restock Batch ID
  reason      String?
  createdAt   DateTime              @default(now())

  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

model StockReservation {
  id        String         @id @onCreate(uuid())
  variantId String
  orderId   String?
  quantity  Int
  expiresAt DateTime
  isSettled Boolean        @default(false)
  createdAt DateTime       @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([expiresAt, isSettled])
}

// ----------------------------------------------------
// SHOPPING (CART & WISHLIST)
// ----------------------------------------------------
model Cart {
  id        String     @id @onCreate(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @onCreate(now()) @onUpdate(now())

  user      User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @onCreate(uuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @onCreate(now()) @onUpdate(now())

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Wishlist {
  id        String         @id @onCreate(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @onCreate(now()) @onUpdate(now())

  user      User           @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @onCreate(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// ----------------------------------------------------
// ORDERS
// ----------------------------------------------------
model Order {
  id             String               @id @onCreate(uuid())
  orderNumber    String               @unique
  userId         String
  status         OrderStatus          @default(PENDING)
  currency       String               @default("INR")
  subtotal       NumericString(12, 2)
  discountTotal  NumericString(12, 2) @default(0)
  taxTotal       NumericString(12, 2) @default(0)
  shippingTotal  NumericString(12, 2) @default(0)
  grandTotal     NumericString(12, 2)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @onCreate(now()) @onUpdate(now())

  user           User                 @relation(fields: [userId], references: [uid], onDelete: Restrict)
  items          OrderItem[]
  address        OrderAddress?
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id             String               @id @onCreate(uuid())
  orderId        String
  variantId      String
  productName    String // Snapshot
  sku            String // Snapshot
  unitPrice      NumericString(12, 2) // Snapshot
  quantity       Int
  discountAmount NumericString(12, 2) @default(0)
  taxAmount      NumericString(12, 2) @default(0)
  totalPrice     NumericString(12, 2)
  createdAt      DateTime             @default(now())

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  id            String   @id @onCreate(uuid())
  orderId       String   @unique
  recipientName String
  phoneNumber   String
  streetAddress String
  apartment     String?
  city          String
  state         String
  postalCode    String
  country       String
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String      @id @onCreate(uuid())
  orderId   String
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ----------------------------------------------------
// PAYMENTS
// ----------------------------------------------------
model Payment {
  id                String               @id @onCreate(uuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String?              @unique
  amount            NumericString(12, 2)
  currency          String               @default("INR")
  status            PaymentStatus        @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @onCreate(now()) @onUpdate(now())

  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions      PaymentTransaction[]
  refunds           Refund[]

  @@index([orderId])
  @@index([providerPaymentId])
}

model PaymentTransaction {
  id         String   @id @onCreate(uuid())
  paymentId  String
  type       String // AUTHORIZE, CAPTURE, REFUND
  status     String
  rawPayload Json?
  createdAt  DateTime @default(now())

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PaymentWebhookEvent {
  id          String          @id @onCreate(uuid())
  provider    PaymentProvider
  eventId     String          @unique
  eventType   String
  payload     Json
  isProcessed Boolean         @default(false)
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([provider, eventId])
}

model Refund {
  id               String               @id @onCreate(uuid())
  paymentId        String
  amount           NumericString(12, 2)
  reason           String?
  providerRefundId String?              @unique
  status           PaymentStatus        @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @onCreate(now()) @onUpdate(now())

  payment          Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

// ----------------------------------------------------
// PROMOTIONS & COUPONS
// ----------------------------------------------------
model Coupon {
  id            String                @id @onCreate(uuid())
  code          String                @unique
  description   String?
  discountType  DiscountType
  discountValue NumericString(10, 2)
  minOrderValue NumericString(12, 2)?
  maxDiscount   NumericString(10, 2)?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  perUserLimit  Int                   @default(1)
  usedCount     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @onCreate(now()) @onUpdate(now())

  usages        CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id       String   @id @onCreate(uuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model Promotion {
  id            String               @id @onCreate(uuid())
  name          String
  description   String?
  discountType  DiscountType
  discountValue NumericString(10, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @onCreate(now()) @onUpdate(now())
}

// ----------------------------------------------------
// SHIPPING
// ----------------------------------------------------
model ShippingMethod {
  id            String               @id @onCreate(uuid())
  name          String
  price         NumericString(10, 2)
  estimatedDays String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())

  shipments     Shipment[]
}

model Shipment {
  id               String             @id @onCreate(uuid())
  orderId          String
  shippingMethodId String?
  carrier          String?
  trackingNumber   String?            @unique
  status           String             @default("PENDING")
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @onCreate(now()) @onUpdate(now())

  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod?    @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  trackingEvents   ShipmentTracking[]

  @@index([orderId])
  @@index([trackingNumber])
}

model ShipmentTracking {
  id          String   @id @onCreate(uuid())
  shipmentId  String
  status      String
  location    String?
  timestamp   DateTime @default(now())
  description String?

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ----------------------------------------------------
// CUSTOMER EXPERIENCE (REVIEWS, RETURNS, NOTIFICATIONS)
// ----------------------------------------------------
model Review {
  id         String   @id @onCreate(uuid())
  productId  String
  userId     String
  rating     Int // 1 to 5
  title      String?
  comment    String?
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @onCreate(now()) @onUpdate(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model ReturnRequest {
  id        String       @id @onCreate(uuid())
  orderId   String
  userId    String
  reason    String
  status    ReturnStatus @default(REQUESTED)
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @onCreate(now()) @onUpdate(now())

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items     ReturnItem[]

  @@index([orderId])
  @@index([userId])
}

model ReturnItem {
  id              String         @id @onCreate(uuid())
  returnRequestId String
  variantId       String
  quantity        Int
  createdAt       DateTime       @default(now())

  returnRequest   ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([returnRequestId])
}

model Notification {
  id        String   @id @onCreate(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId])
}
